# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Firebase Admin SDK
# Option A: point to a downloaded service account JSON file (recommended for local dev)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B: provide the service account as inline values (useful for hosting providers)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# Rate limiting (ticket booking endpoint)
BOOKING_RATE_LIMIT_WINDOW_MS=60000
BOOKING_RATE_LIMIT_MAX=10
