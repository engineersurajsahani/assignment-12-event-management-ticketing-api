# ---------- Server ----------
# macOS tip: AirPlay Receiver occupies port 5000, so default is 5001.
PORT=5001

# ---------- JWT ----------
JWT_SECRET=assignment12_ticketing_secret_key_change_me
JWT_EXPIRES_IN=7d

# ---------- Firebase (choose ONE credential method) ----------
# Option A (Render/Railway/Vercel recommended): paste the FULL contents of
# serviceAccountKey.json (the whole { ... } object) as a multiline secret:
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Option B: path to the downloaded service account JSON file (local dev)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option C: standard Google default credentials file
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json